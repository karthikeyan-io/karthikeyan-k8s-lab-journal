# Run the command: You can check for apiVersion of replicaset by command kubectl api-resources | grep replicaset

kubectl api-resources | grep replicaset

controlplane ~ ➜  kubectl api-resources | grep replicaset
replicasets                         rs           apps/v1                             true         ReplicaSet

controlplane ~ ➜  
controlplane ~ ➜  kubectl explain replicaset | grep VERSION
VERSION:    v1

controlplane ~ ➜  cat replicaset-definition-1.yaml
apiVersion: apps/v1
kind: ReplicaSet
metadata:
  name: replicaset-1
spec:
  replicas: 2
  selector:
    matchLabels:
      tier: frontend
  template:
    metadata:
      labels:
        tier: frontend
    spec:
      containers:
      - name: nginx
        image: nginx

kubectl apply -f /root/replicaset-definition-2.yaml
kubectl create -f replicaset-definition-2.yaml

kubectl scale replicaset new-replica-set --replicas=2
